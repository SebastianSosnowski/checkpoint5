<launch>

  <!-- Declare launch arguments -->
  <arg name="obstacle" default="0.1"/>
  <arg name="degrees" default="90.0"/>

  <!-- Node definition -->
  <node
    pkg="attach_shelf"
    exec="pre_approach_executable"
    name="pre_approach_node"
    output="screen"
    emulate_tty="true">
    <!-- Parameters -->
    <param name="obstacle" value="$(var obstacle)"/>
    <param name="degrees" value="$(var degrees)"/>

  </node>

</launch>